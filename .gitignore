_site
.DS_Store
node_modules/
importing/
bytesofpurpose-blog/static/storybook/

# Secrets — NEVER commit. Consumed by .claude/skills/manage-cloudflare-access
.env
.env.*
!.env.example
# dotenvx secrets-at-rest: the plaintext .env stays gitignored above; the
# ENCRYPTED sidecar is committed (every value is `encrypted:…`, unreadable
# without .env.keys, which stays gitignored and lives in LastPass). The
# check-env-encrypted gate guards these exceptions against a plaintext slip.
!.env.encrypted
!.env.*.encrypted
*.token
cloudflared/*.json

# Local Claude settings (machine-specific)
.claude/settings.local.json

# Git worktrees created under .claude (never commit a nested checkout)
.claude/worktrees/

# Python bytecode (skill helper scripts)
__pycache__/
*.pyc
.claude/plans/routes-before.txt
.claude/scheduled_tasks.lock
.claude/skills/discover-my-journey/.last-run
.audit-tmp/
packages/*/dist/
.claude/.scratch-screenshots/
